# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*

# generated files
/dist/
/outputs/
/work/

# Native staging and runtime downloads
/.build/

# Python caches
__pycache__/
*.py[cod]

# Build outputs that native/build-app.sh regenerates into .build/
/native/qr
/native/telemetry

# Local runtime data and signing material
*.sqlite3
*.sqlite3-*
*.key
*.p8
*.p12

# Development-only dependencies; rebuild with native/setup-dev.sh
/native/push_vendor/

# TypeScript incremental cache
*.tsbuildinfo
